# cv_backend .env configuration
# Project settings
PROJECT_NAME=Computer Vision API
API_V1_STR=/api/v1
 
# Database configuration (PostgreSQL with asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:admin@localhost:5432/cv_db
 
# Security configuration
SECRET_KEY=super-secret-key-for-development-only-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=600
COOKIE_SECURE=False
COOKIE_SAMESITE=lax
BACKEND_CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000", "http://localhost:3001", "http://127.0.0.1:3001", "http://localhost:3002", "http://127.0.0.1:3002", "http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:8000", "http://127.0.0.1:8000"]
 
# Storage configuration
STORAGE_PROVIDER=local   # options: local, s3
LOCAL_STORAGE_PATH=storage
 
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=
AWS_S3_REGION=us-east-1
AWS_S3_KEY_PREFIX=vigilens
 
# RTSP configuration
RTSP_RETRY_INTERVAL=5
 
# Celery configuration
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
 
# Redis Cache configuration
REDIS_URL=redis://localhost:6379/1

# Advanced People Analytics Configuration (Tweakable Thresholds)
ADVANCED_FACE_SIMILARITY_THRESHOLD=0.48
ADVANCED_REID_SIMILARITY_THRESHOLD=0.75
ADVANCED_FACE_MIN_SIZE=22
ADVANCED_FACE_MIN_DET_SCORE=0.50
ADVANCED_CROSS_CAMERA_MIN_SCORE=0.65
PROCESS_EVERY_FRAME=false
PROCESSING_FPS=7.5
FEATURE_LOCK_SHOTS=2
REID_MEMORY_BANK_TTL_SEC=45.0
REID_MEMORY_BANK_SIMILARITY_THRESHOLD=0.75

# SQL Agent & LLM Configuration (Cloud / Local)
# Options: gemini | groq | openai | ollama | openrouter
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.0-flash
# Your Google Gemini API Key:
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Ollama Local Settings (for later seamless offline swap)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:latest

SQL_AGENT_TIMEOUT_SECONDS=10.0
SQL_AGENT_MAX_ROWS=100
SQL_AGENT_MAX_RETRIES=3
